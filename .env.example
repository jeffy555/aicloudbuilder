# ==============================================================================
# AI-Driven DevOps Platform - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ------------------------------------------------------------------------------
# OpenAI Configuration (Required)
# ------------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# GitHub Integration (Required for GitHub provider)
# ------------------------------------------------------------------------------
# Create a Personal Access Token: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username-or-org

# ------------------------------------------------------------------------------
# Azure DevOps Integration (Required for Azure DevOps provider)
# ------------------------------------------------------------------------------
# Create a PAT: https://dev.azure.com/{org}/_usersSettings/tokens
# Required scopes: Code (Read & Write), Project and Team (Read)
AZURE_DEVOPS_ORG=your-org-name
AZURE_DEVOPS_PROJECT=your-project-name
AZURE_DEVOPS_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_DEVOPS_USER_ID=your-user-id

# ------------------------------------------------------------------------------
# Azure Cloud Integration (Required for Azure backend provisioning)
# ------------------------------------------------------------------------------
# The Azure MCP server uses Azure CLI for authentication
# Run 'az login' before starting the application
# No explicit credentials needed here - uses Azure CLI session

# ------------------------------------------------------------------------------
# Session Management (Required)
# ------------------------------------------------------------------------------
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-secret-here-use-crypto-randomBytes

# ------------------------------------------------------------------------------
# Database Configuration (Optional - uses in-memory storage by default)
# ------------------------------------------------------------------------------
# Uncomment and configure if you want persistent storage
# DATABASE_URL=postgresql://user:password@localhost:5432/devops_platform
