# -----------------------------------------------------------------------------
# VM deployment environment (copy to .env.vm on the VM)
# -----------------------------------------------------------------------------

# Public domain pointed to your VM IP (A record)
APP_DOMAIN=app.example.com

# PostgreSQL (container)
POSTGRES_DB=spiritops
POSTGRES_USER=spiritops
POSTGRES_PASSWORD=change_this_to_a_strong_password

# App runtime
NODE_ENV=production
PORT=9005

# IMPORTANT: App requires DATABASE_URL in production
DATABASE_URL=postgresql://spiritops:change_this_to_a_strong_password@postgres:5432/spiritops?sslmode=disable
JWT_SECRET=change_this_to_a_long_random_secret

# Integrations (set your real values)
OPENAI_API_KEY=
BITWARDEN_ACCESS_TOKEN=
BITWARDEN_PROJECT_ID=

# Optional provider defaults
GITHUB_TOKEN=
GITHUB_OWNER=
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_PROJECT=
